rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * RECOVERY ENGINE — ROLE-BASED ACCESS CONTROL (RBAC)
     * 
     * Roles:
     * - 'teacher' / 'professor': Can create classes, add/remove students, schedule lecture plans, mark attendance.
     * - 'student': Read-only access to class schedule, lecture plans, recaps, and personal notifications.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isNotAnonymous() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Fetches the user profile document for the current authenticated user
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isTeacher() {
      return isNotAnonymous() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (getUserData().role == 'teacher' || getUserData().role == 'professor');
    }

    function isStudent() {
      return isNotAnonymous() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == 'student';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isClassTeacher(teacherId) {
      return isTeacher() && request.auth.uid == teacherId;
    }

    // --- User Profiles ---
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isTeacher(); // Teachers can browse students for enrollment
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // --- Legacy Profile Collections (Teacher / Student) ---
    match /teachers/{teacherId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update: if isOwner(teacherId);
      allow delete: if false;
    }

    match /students/{studentId} {
      allow get: if isSignedIn();
      allow list: if isTeacher();
      allow create, update: if isOwner(studentId);
      allow delete: if false;
    }

    // --- Classes (Target Unified Model) ---
    match /classes/{classId} {
      // Students and Teachers can view classes
      allow get, list: if isSignedIn();

      // Only teachers/professors can create classes
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if isClassTeacher(resource.data.teacherId);

      // --- Class Members (Add/Remove Students) ---
      // Teacher can add or remove students; Students can only view
      match /members/{memberId} {
        allow get, list: if isSignedIn();
        allow create: if isTeacher() && get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == request.auth.uid;
        allow update, delete: if isTeacher() && get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == request.auth.uid;
      }

      // --- Lecture Planner & Schedule ---
      // Students can access lecture plans, upcoming topics, and schedule (READ-ONLY)
      // Teachers can create, modify, and delete lecture plans
      match /lecturePlans/{lecturePlanId} {
        allow get, list: if isSignedIn();
        allow create: if isTeacher() && get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == request.auth.uid;
        allow update, delete: if isTeacher() && get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == request.auth.uid;
      }

      // --- Attendance Records ---
      // Teachers record attendance; Students can read
      match /attendanceRecords/{attendanceId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if isTeacher() && get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == request.auth.uid;
      }

      // --- Study Materials ---
      match /studyMaterials/{materialId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if isTeacher() && get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == request.auth.uid;
      }
    }

    // --- Courses (Existing Prototype Model) ---
    match /courses/{courseId} {
      allow get, list: if isSignedIn();
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if isTeacher() && resource.data.teacherId == request.auth.uid;

      // Student enrollments: Only course teacher can add/remove students
      match /enrollments/{enrollmentId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if isTeacher() && 
          (resource == null ? request.resource.data.teacherId == request.auth.uid : resource.data.teacherId == request.auth.uid);
      }

      // Lecture planner & schedule: Students read-only, teacher write
      match /lecturePlans/{lecturePlanId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if isTeacher() &&
          (resource == null ? request.resource.data.teacherId == request.auth.uid : resource.data.teacherId == request.auth.uid);

        match /attendanceRecords/{attendanceId} {
          allow get, list: if isSignedIn();
          allow create, update, delete: if isTeacher() &&
            (resource == null ? request.resource.data.teacherId == request.auth.uid : resource.data.teacherId == request.auth.uid);
        }
      }

      match /studyMaterials/{studyMaterialId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if isTeacher() &&
          (resource == null ? request.resource.data.teacherId == request.auth.uid : resource.data.teacherId == request.auth.uid);
      }
    }

    // --- Absentee Notifications (Audit Log) ---
    match /absenteeNotifications/{notificationId} {
      allow get, list: if isSignedIn() && (
        isTeacher() || 
        resource.data.studentId == request.auth.uid ||
        resource.data.studentEmail == request.auth.token.email
      );
      // Only authorized teachers can generate notifications
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if false; // Append-only audit log
    }
  }
}